# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Seguridad y Sesiones
# Se recomienda una clave secreta segura para firmar cookies de sesión
SESSION_SECRET=tlapaleria_central_dev_secret_2026_super_secure_key

# URL Base para enlaces de desarrollo (consola)
APP_URL=http://localhost:3000

# Parámetros de seguridad de contraseñas y sesiones
# Duración de inactividad de sesión en milisegundos (30 minutos = 1800000 ms)
SESSION_MAX_AGE_MS=1800000

# Caducidad de token de verificación en ms (24 horas = 86400000 ms)
VERIFICATION_TOKEN_TTL_MS=86400000

# Caducidad de token de recuperación en ms (30 minutos = 1800000 ms)
PASSWORD_RESET_TOKEN_TTL_MS=1800000

# Pausa temporal por intentos fallidos (Propuesta técnica: 15 minutos = 900000 ms)
LOCKOUT_TIME_MS=900000
MAX_FAILED_ATTEMPTS=5

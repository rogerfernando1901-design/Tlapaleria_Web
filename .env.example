# Configuración del Servidor
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Seguridad y Sesiones
SESSION_SECRET=tlapaleria_central_dev_secret_2026_super_secure_key
SESSION_MAX_AGE_MS=1800000

# Caducidades de Tokens (ms)
VERIFICATION_TOKEN_TTL_MS=86400000
PASSWORD_RESET_TOKEN_TTL_MS=1800000
LOCKOUT_TIME_MS=900000
MAX_FAILED_ATTEMPTS=5

# Configuración de Correo Electrónico en Tiempo Real (Gmail con Nodemailer)
# Requiere una cuenta de Gmail con verificación en 2 pasos y una Contraseña de Aplicación de 16 caracteres
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="Tlapalería Central" <tu_correo@gmail.com>
